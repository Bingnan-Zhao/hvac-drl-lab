within ;
package HVACViz "Models for the interactive 3D viewer of Case 05 (local use, not part of the repository)"
  annotation (uses(Buildings(version="12.0.0"), Modelica(version="4.0.0")),
    Documentation(info="<html>
<p>Copy of <code>HVACDRL.Case05</code> with zone set points, outdoor air fraction and internal gain
multipliers as inputs, so that they can be changed while the FMU runs.</p>
</html>"));
end HVACViz;
